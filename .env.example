# Variables públicas del proyecto Supabase.
# Copiá este archivo como .env.local y completá los valores del dashboard.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Opcional: OpenRouter para extraer el total y los productos de tickets.
# La clave se usa únicamente en el servidor y nunca debe llevar el prefijo VITE_.
OPENROUTER_API_KEY=
# En Vercel Preview se usa este modelo gratis por defecto (50 solicitudes por día).
OPENROUTER_RECEIPT_PREVIEW_MODEL=nvidia/nemotron-3.5-super-vl:free
# En producción se mantiene el modelo configurado aquí o, por defecto, DeepSeek.
OPENROUTER_RECEIPT_MODEL=deepseek/deepseek-v4.1-flash
