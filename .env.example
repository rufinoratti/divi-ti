# Variables públicas del proyecto Supabase.
# Copiá este archivo como .env.local y completá los valores del dashboard.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Opcional: OpenRouter para extraer el total y los productos de tickets.
# La clave se usa únicamente en el servidor y nunca debe llevar el prefijo VITE_.
OPENROUTER_API_KEY=
# Modelo principal gratis; admite imágenes y tiene un límite de 50 solicitudes por día.
OPENROUTER_RECEIPT_PRIMARY_MODEL=nvidia/nemotron-3.5-super-vl:free
# Respaldo para fallos del proveedor o resultados vacíos; puede usar saldo de OpenRouter.
OPENROUTER_RECEIPT_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
