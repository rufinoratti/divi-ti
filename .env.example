# Variables públicas del proyecto Supabase.
# Copiá este archivo como .env.local y completá los valores del dashboard.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Opcional: IA para extraer el total y los productos de tickets.
# La clave se usa únicamente en el servidor y nunca debe llevar el prefijo VITE_.
OPENROUTER_API_KEY=
OPENROUTER_RECEIPT_MODEL=deepseek/deepseek-v4.1-flash
