VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: OpenRouter receipt analysis.
# Keep this server-only; never add the VITE_ prefix.
OPENROUTER_API_KEY=
# Free primary model for image and document analysis (50 requests per day).
OPENROUTER_RECEIPT_PRIMARY_MODEL=nvidia/nemotron-3.5-super-vl:free
# Used after provider failures or empty results; may use OpenRouter credits.
OPENROUTER_RECEIPT_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
