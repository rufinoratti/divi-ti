VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: OpenRouter receipt analysis.
# Keep this server-only; never add the VITE_ prefix.
OPENROUTER_API_KEY=
# Vercel Preview defaults to this free vision model (50 requests per day).
OPENROUTER_RECEIPT_PREVIEW_MODEL=nvidia/nemotron-3.5-super-vl:free
# Production uses the configured model or DeepSeek by default.
OPENROUTER_RECEIPT_MODEL=deepseek/deepseek-v4.1-flash
